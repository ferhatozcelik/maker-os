# Taban surum pini.
# 01-pin-base.sh bu dosyayi "base.env" olarak uretir; .example surumu
# repo'da referans icin tutulur, ciktinin elle duzenlenmesi gerekmez.

# Pardus 21 ("yirmibir") - Debian Bullseye tabanli, arm64 depo dogrulandi
# (bkz. docs/mimari.md ve docs/kararlar.md, 20.10.2026 kontrolu).
PARDUS_SUITE=yirmibir
PARDUS_ARCH=arm64
PARDUS_MIRROR=http://depo.pardus.org.tr/pardus
PARDUS_COMPONENTS="main contrib non-free"

# debootstrap bu suite icin hazir script bilmiyor (Pardus turevi); en
# yakin Debian codename'inden kopyalanir (bkz. 02-build-rootfs.sh).
DEBOOTSTRAP_BASE_CODENAME=bullseye

# Pinlenen anda depo Release dosyasinin tarihi (tekrarlanabilirlik icin
# kayit amaclidir; depo snapshot/freeze mekanizmasi saglamiyor).
PARDUS_RELEASE_DATE_SEEN="2026-07-15"
PIN_RECORDED_AT="2026-10-20"

# Guvenlik guncellemeleri deposu (arm64 iceriyor, 21.10.2026 kontrolu).
PARDUS_SECURITY_MIRROR=http://depo.pardus.org.tr/guvenlik
PARDUS_SECURITY_SUITE=yirmibir

# Raspberry Pi kernel/bootloader kaynagi (raspberrypi/firmware). Bos
# birakilirsa build aninda "master" dalinin commit'i cozulur ve
# manifest'e yazilir.
RPI_FIRMWARE_REF=cceff4554e21713dd387b9bf3840e3b967fdbdd9

# Wi-Fi/Bluetooth firmware'i: Raspberry Pi OS'in kendi paketleri
# (Debian bullseye'daki 2021 surumu yerine, guncel kernel ile uyumlu).
RPI_APT_MIRROR=http://archive.raspberrypi.com/debian
RPI_APT_SUITE=bookworm
# Kamera yigini (libcamera, libcamera-apps, picamera2): Pardus 21 ile ayni
# taban (bullseye) icin derlenmis RPi paketleri (04-install-desktop.sh).
RPI_CAMERA_SUITE=bullseye

# Build sirasinda kullanilan ayna. depo.pardus.org.tr paket dosyalarini
# zaten buraya yonlendiriyor ve 21.10.2026'da aralikli erisilemez oldu.
# Son imajdaki sources.list resmi adresleri (yukaridaki) kullanir.
PARDUS_BUILD_MIRROR=https://ulakbimdepo2.pardus.org.tr/pardus
PARDUS_BUILD_SECURITY_MIRROR=https://ulakbimdepo2.pardus.org.tr/guvenlik

# Gelistirme araclari (05-install-dev-tools.sh). Surumler build aninda en
# guncel kararli surume cozulur ve manifest'e yazilir.
# Hazir AI ortaminin Python surumu: torch/onnxruntime/litert wheel'larinin
# hepsinin arm64'te bulundugu surum. (lgpio'nun arm64 wheel'lari glibc 2.34
# istiyor, Pardus 21'de 2.31 var; GPIO icin RPi.GPIO kullanilir.)
PIOS_AI_PYTHON=3.12
PARDUS_YUZYIL_DEB=https://ulakbimdepo2.pardus.org.tr/pardus/pool/main/p/pardus-yuzyil/pardus-yuzyil_1.0.0_all.deb
