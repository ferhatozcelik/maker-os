[Unit]
Description=MakerOS uzak masaustu (x11vnc, ekran :0)
After=lightdm.service
Wants=lightdm.service

[Service]
# Kararli 30 FPS: ekran 33 ms'de bir yoklanir (wait), degisiklikler en fazla
# 10 ms biriktirilir (defer). Daha sik yoklama Pi'de CPU'yu doyurup FPS'i
# dalgalandirir. nonap: bostayken yavaslamaz, ilk kareler gecikmez.
# pointer_mode 4: LAN icin hizli imlec; speeds lan: sikistirma LAN varsayar.
# Merkez > Ekran cozunurlugu tarayiciya uydurunca bu servisi yeniden
# baslatir (canli boyut degisikligi siyah/eksik kare verebiliyor).
ExecStart=/usr/bin/x11vnc -display WAIT:0 -auth guess -forever -loop -shared \
  -rfbauth /etc/pios/vnc.pass -rfbport 5900 -repeat -threads -nonap \
  -pointer_mode 4 -defer 10 -wait 33 -speeds lan -cursor arrow -quiet
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
