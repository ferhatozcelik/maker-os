[Unit]
Description=Pardus Maker ilk acilis hazirligi (bolum genisletme, SSH anahtarlari)
ConditionPathExists=!/var/lib/pios/firstboot-done
After=local-fs.target
Before=ssh.service lightdm.service
DefaultDependencies=no
