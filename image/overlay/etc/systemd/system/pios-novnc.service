[Unit]
Description=Pardus Maker tarayicidan masaustu (websockify, yalnizca 127.0.0.1:6080; Merkez > Ekran port 80 uzerinden aktarir)
After=pios-vnc.service network.target
Wants=pios-vnc.service

[Service]
ExecStart=/usr/bin/websockify 127.0.0.1:6080 localhost:5900
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
