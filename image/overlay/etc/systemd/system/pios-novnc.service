[Unit]
Description=Pardus Maker tarayicidan masaustu (websockify, port 6080; Merkez > Ekran kullanir)
After=pios-vnc.service network.target
Wants=pios-vnc.service

[Service]
ExecStart=/usr/bin/websockify --web=/usr/share/novnc 6080 localhost:5900
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
