<?xml version="1.0" encoding="UTF-8"?>
<!-- Pencere dugmeleri solda (kapat, kucult, buyut), baslik ortada.
     Compositing kapali: xfwm4 efektleri CPU ile cizer ve her degisiklikte
     genis alanlari yeniden boyar; Pi'de pencere tasima ve uzak ekran (VNC)
     belirgin yavaslar. Dock seffaf degil, duz arka planlidir.
     placement_ratio 0: her yeni pencere ekranin ortasinda acilir. -->
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="theme" type="string" value="pardus-default"/>
    <property name="button_layout" type="string" value="CHM|"/>
    <property name="title_alignment" type="string" value="center"/>
    <property name="title_font" type="string" value="Inter Semi-Bold 10"/>
    <property name="use_compositing" type="bool" value="false"/>
    <property name="show_frame_shadow" type="bool" value="false"/>
    <property name="show_popup_shadow" type="bool" value="false"/>
    <property name="show_dock_shadow" type="bool" value="false"/>
    <property name="workspace_count" type="int" value="1"/>
    <property name="placement_ratio" type="int" value="0"/>
    <property name="placement_mode" type="string" value="center"/>
  </property>
</channel>
