# MakerOS debug: USB-C uzerinden ag (usb-gadget). NetworkManager usb0'a 10.55.0.1 verir.
[Unit]
Description=MakerOS debug USB ag karti
DefaultDependencies=no
After=sys-kernel-config.mount systemd-modules-load.service systemd-udevd.service systemd-udev-trigger.service
Before=NetworkManager.service network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/makeros/usb-gadget

[Install]
WantedBy=sysinit.target
