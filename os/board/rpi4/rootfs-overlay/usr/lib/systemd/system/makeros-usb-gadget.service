# MakerOS: USB-C uzerinden ag (usb-gadget). usb0 10.42.0.1 alir.
[Unit]
Description=MakerOS USB ag karti
DefaultDependencies=no
After=sys-kernel-config.mount systemd-modules-load.service systemd-udevd.service systemd-udev-trigger.service
Before=NetworkManager.service network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
# oneshot'ta varsayilan zaman siniri yok; acilisi asla kilitlemesin.
TimeoutStartSec=30
ExecStart=/usr/lib/makeros/usb-gadget

[Install]
WantedBy=sysinit.target
