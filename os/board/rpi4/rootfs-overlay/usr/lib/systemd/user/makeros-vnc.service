# Uzak masaustu: wayvnc yalnizca 127.0.0.1:5900'de (ham RFB) dinler.
# Disariya acik degildir; makerd /api/v1/vnc uzerinden yonetici oturumunu
# dogrulayip WebSocket <-> TCP koprusu kurar, tarayicida noVNC baglanir.
[Unit]
Description=MakerOS uzak masaustu (wayvnc)
PartOf=graphical-session.target

[Service]
Type=simple
Slice=shell.slice
# -g: GPU yakalama (dmabuf). -f 30: Pi 4'te CPU'yu yormadan akici goruntu.
# GPU yoksa (yazilim cizim yedegi) --gpu kullanilmaz.
ExecStart=/bin/sh -c 'G=; ls /dev/dri/renderD* >/dev/null 2>&1 && G=--gpu; exec /usr/bin/wayvnc $G --max-fps=30 --render-cursor 127.0.0.1 5900'
Restart=on-failure
RestartSec=2
