<?xml version="1.0"?>
<!-- MakerOS uzak tarayıcı oturumu (browser-session): yalnız Chromium, çerçevesiz ve ekranı kaplar;
     pencerenin başlığı/düğmeleri MakerOS penceresinde. -->
<labwc_config>
  <core><decoration>client</decoration><gap>0</gap></core>
  <placement><policy>center</policy></placement>
  <focus><followMouse>no</followMouse></focus>
  <windowRules>
    <windowRule identifier="*" serverDecoration="no">
      <action name="Maximize"/>
    </windowRule>
  </windowRules>
  <keyboard><default/></keyboard>
</labwc_config>
