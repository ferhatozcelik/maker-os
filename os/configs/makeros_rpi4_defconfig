# MakerOS 2 - Raspberry Pi 4 / 400 (aarch64, 4 GB)
# Buildroot 2026.02.3 + BR2_EXTERNAL MAKEROS

# --- Mimari ---------------------------------------------------------------------
BR2_aarch64=y
BR2_cortex_a72=y
BR2_ARM_FPU_VFPV4=y

# --- Derleme --------------------------------------------------------------------
BR2_CCACHE=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_MAKEROS_PATH)/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_OPTIMIZE_2=y

# --- Toolchain ------------------------------------------------------------------
# Bootlin hazir toolchain'leri yalnizca x86_64 host icin var (Config.in:
# depends on BR2_HOSTARCH = "x86_64"); arm64 Docker'da Buildroot'un kendi
# glibc toolchain'i derlenir (gcc 14, glibc 2.42, headers 6.18).
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_KERNEL_HEADERS_6_18=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# --- Sistem ---------------------------------------------------------------------
BR2_TARGET_GENERIC_HOSTNAME="makeros"
BR2_TARGET_GENERIC_ISSUE="MakerOS"
BR2_INIT_SYSTEMD=y
BR2_INIT_SYSTEMD_VAR_NONE=y
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_SYSTEM_BIN_SH_BASH=y
# BR2_TARGET_GENERIC_GETTY is not set
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_MAKEROS_PATH)/board/rpi4/users.txt"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_MAKEROS_PATH)/board/rpi4/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_MAKEROS_PATH)/board/rpi4/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_MAKEROS_PATH)/board/rpi4/post-image.sh"
BR2_ENABLE_LOCALE_WHITELIST="C en_US tr_TR"
BR2_GENERATE_LOCALE="en_US.UTF-8 tr_TR.UTF-8"
BR2_TARGET_TZ_INFO=y
BR2_TARGET_LOCALTIME="Europe/Istanbul"

# --- Cekirdek: raspberrypi/linux rpi-6.18.y (6.18.59), sabit commit ------------
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,b3495ea401d709af0701a85babcba5e3d788a602)/linux-b3495ea401d709af0701a85babcba5e3d788a602.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2711"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_MAKEROS_PATH)/board/rpi4/linux.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2711-rpi-4-b broadcom/bcm2711-rpi-400 broadcom/bcm2711-rpi-cm4"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# --- Pi firmware ----------------------------------------------------------------
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI4=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_MAKEROS_PATH)/board/rpi4/config.txt"
# BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTBS is not set
BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTB_OVERLAYS=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_BT=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y
BR2_PACKAGE_WIRELESS_REGDB=y

# --- systemd --------------------------------------------------------------------
BR2_PACKAGE_SYSTEMD_ANALYZE=y
BR2_PACKAGE_SYSTEMD_HOSTNAMED=y
BR2_PACKAGE_SYSTEMD_HWDB=y
BR2_PACKAGE_SYSTEMD_LOCALED=y
