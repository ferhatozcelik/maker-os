config BR2_PACKAGE_LLAMA_CPP
	bool "llama-cpp"
	depends on BR2_aarch64
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	help
	  llama.cpp: yerel LLM çıkarımı (llama-server, llama-cli).
	  makeros-ai (Türkçe Linux asistanı) llama-server'ı kullanır.
	  Pi 4 (Cortex-A72, NEON) için derlenir; OpenMP ve curl kapalı
	  (çalışma zamanında internet gerekmez).

	  https://github.com/ggml-org/llama.cpp

comment "llama-cpp C++ ve iş parçacığı destekli araç zinciri ister"
	depends on BR2_aarch64
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS
