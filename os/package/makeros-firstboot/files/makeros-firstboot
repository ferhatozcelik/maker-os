#!/bin/sh
# MakerOS ilk acilis hazirligi (kullanici etkilesimi yok). Bir kez calisir;
# isaret: /var/lib/makeros/firstboot-done (DATA uzerinde).
#  - cihaza ozel ana makine adi: makeros-XXXX (seri numarasinin son 4 hanesi)
#  - SSH host anahtarlari (imajda ortak anahtar yok; sshd sihirbaza kadar kapali)
# Bolum buyutme makeros-growdata.service'tedir (her acilista, idempotent).
set -u
STAMP=/var/lib/makeros/firstboot-done
log() { echo "makeros-firstboot: $*"; }

if [ -e /run/makeros/volatile ]; then
	log "gecici mod: ilk acilis isaretlenmeyecek"
fi

serial="$(tr -d '\0' < /proc/device-tree/serial-number 2>/dev/null | tail -c 4)"
[ -n "${serial}" ] || serial="$(tr -dc 'a-f0-9' < /dev/urandom | head -c 4)"
host="makeros-$(echo "${serial}" | tr 'A-F' 'a-f')"
if [ ! -s /etc/hostname ] || [ "$(cat /etc/hostname)" = makeros ]; then
	echo "${host}" > /etc/hostname
	hostname "${host}"
	log "ana makine adi: ${host}"
fi

log "SSH host anahtarlari uretiliyor"
ssh-keygen -A >/dev/null 2>&1 || log "ssh-keygen basarisiz"

# NOT: kurulum tamamlanma isareti (/var/lib/makerd/setup-done) burada
# OLUSTURULMAZ; yalnizca sihirbaz (makerd-priv) yazar.

if [ ! -e /run/makeros/volatile ]; then
	mkdir -p "$(dirname "${STAMP}")"
	date -u +%FT%TZ > "${STAMP}"
fi
log "tamamlandi"
