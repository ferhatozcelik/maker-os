# Soketle etkinleşir, 30 sn boşta kalınca çıkar. Yalnız sabit komutlar.
[Unit]
Description=makerd yetkili yardımcı (makerd-priv)
Requires=makerd-priv.socket
After=makerd-priv.socket

[Service]
Type=notify
ExecStart=/usr/bin/makerd-priv --allow-user maker --idle 30s --setup-flag /var/lib/makerd/setup-done
NoNewPrivileges=yes
ProtectSystem=strict
# /etc: passwd/group/shadow/hostname, systemd birim bağlantıları; /home: user.create ev dizini.
ReadWritePaths=/etc /home
ProtectHome=no
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER CAP_SYS_ADMIN CAP_SYS_BOOT
MemoryMax=32M
