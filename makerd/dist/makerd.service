# Örnek birim (os/ ajanı uyarlayabilir). makerd yetkisiz "maker" kullanıcısıyla çalışır.
[Unit]
Description=MakerOS arka uç hizmeti (makerd)
Documentation=file:///usr/share/doc/makerd/README.md
After=network.target dbus.service makerd-priv.socket systemd-tmpfiles-setup.service
Wants=makerd-priv.socket

[Service]
Type=notify
User=maker
Group=maker
SupplementaryGroups=video gpio i2c spi dialout netdev
ExecStart=/usr/bin/makerd --listen :80 --web /usr/share/makeros/shell --data-dir /var/lib/makerd --log-format text
Restart=on-failure
RestartSec=2
StateDirectory=makerd
StateDirectoryMode=0750
# /run/makeros (token + priv.sock) tmpfiles.d/makeros.conf ile oluşturulur.
ReadWritePaths=/run/makeros
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# M2: web terminali makerd-user@<kullanıcı>.service içinde çalışır (bkz.
# makerd-user@.service); makerd yalnız /run/makeros/user/<uid>.sock'a vekillik
# eder. Bu yüzden M1'de kaldırılan sıkılaştırmalar geri geldi.
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0027
MemoryHigh=64M
MemoryMax=128M
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
