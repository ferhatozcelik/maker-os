# Kullanıcı başına terminal hizmeti: makerd-user@<kullanıcı>.service (User=%i).
# makerd-priv user.create bunu "systemctl enable --now" ile açar; elle:
#   systemctl enable --now makerd-user@ayse.service
# makerd'nin kum havuzu dışında çalışır: terminalde sudo çalışır (NoNewPrivileges YOK).
[Unit]
Description=MakerOS kullanıcı hizmeti (%i): web terminali
After=systemd-tmpfiles-setup.service systemd-user-sessions.service
Before=makerd.service

[Service]
Type=notify
User=%i
# Kullanıcının birincil grubu ve /etc/group'taki ek grupları (wheel, video, gpio...) kullanılır.
WorkingDirectory=~
ExecStart=/usr/bin/makerd-user --socket-dir /run/makeros/user --allow-user maker
Restart=always
RestartSec=2
Slice=user.slice
# Kabuklar bu birimin cgroup'unda çalışır; durdurulunca hepsi kapanır.
KillMode=control-group
RuntimeDirectory=user/%U
RuntimeDirectoryMode=0700
UMask=0022
Environment=LANG=C.UTF-8 XDG_RUNTIME_DIR=/run/user/%U
# Kasıtlı olarak NoNewPrivileges/ProtectSystem/MemoryDenyWriteExecute yok: bu
# kullanıcının kendi oturumudur (sudo, podman, Node JIT çalışmalı).
OOMScoreAdjust=100

[Install]
WantedBy=multi-user.target
